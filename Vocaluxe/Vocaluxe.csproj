<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vocaluxe</RootNamespace>
    <AssemblyName>Vocaluxe</AssemblyName>
    <StartupObject>Vocaluxe.CMainProgram</StartupObject>
    <ApplicationIcon>Vocaluxe.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- One cross-platform codebase: OpenGL everywhere (OpenTK 4) + PortAudio, no WinForms/Direct3D.
         The WIN/LINUX symbol is chosen per build OS so the same sources compile correctly on each
         platform. ARCH_X64 selects the 64-bit native-interop paths. -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">WIN;ARCH_X64</DefineConstants>
    <DefineConstants Condition="!$([MSBuild]::IsOSPlatform('Windows'))">LINUX;ARCH_X64</DefineConstants>
    <!-- macOS is a non-Windows platform, so it also gets LINUX (the shared Unix/OpenGL/PortAudio
         paths). MACOS is defined additionally so genuinely Linux-only code (V4L2) can opt out with
         '#if LINUX && !MACOS' and macOS-specific bits can use '#if MACOS'. -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);MACOS</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0649;CS0169;CS0414;CS0162;CA1416;NU1701</NoWarn>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Windows-only backends dropped for the unified cross-platform codebase.
       OpenGL replaces Direct3D, PortAudio replaces DirectSound, the WinForms
       splash/error-reporter are replaced by logging. -->
  <ItemGroup>
    <Compile Remove="Lib\Draw\CDirect3D.cs" />
    <Compile Remove="Lib\Draw\CDrawWinForm.cs" />
    <Compile Remove="Lib\Sound\Record\DirectSound\**\*.cs" />
    <Compile Remove="Lib\Webcam\CAForgeNet.cs" />
    <Compile Remove="Reporting\**\*.cs" />
    <Compile Remove="CSplashScreen.cs" />
    <!-- S3: only the PortAudio backend is migrated for the cross-platform build.
         GStreamer (GstSharp net45-only) and OpenAL (OpenTK 1.x audio, removed in OpenTK 4). -->
    <Compile Remove="Lib\Sound\Playback\GstreamerSharp\**\*.cs" />
    <Compile Remove="Lib\Sound\Playback\OpenAL\**\*.cs" />
    <!-- Orphaned/legacy code: not referenced anywhere and absent from the original build. -->
    <Compile Remove="Animations\**\*.cs" />
    <!-- Orphaned duplicate of Base/Fonts/CGlyph.cs; its namespace Vocaluxe.Base.Font even
         shadowed the System.Drawing.Font type. The real glyph code lives in Base/Fonts. -->
    <Compile Remove="Base\Font\**\*.cs" />
    <EmbeddedResource Remove="Reporting\**\*.resx" />
    <!-- S2: the WCF ICWebservice contract was removed; CWebservice is now an ASP.NET Core
         (Kestrel) endpoint mapper, hosted by CVocaluxeServer. -->
    <Compile Remove="Base\Server\ICWebservice.cs" />
  </ItemGroup>

  <!-- S2: ASP.NET Core (Kestrel) for the browser remote-control webserver -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Party modes are compiled from source at runtime; CodeDom types live in this package on modern .NET.
         TODO(linux-port): runtime CodeDom compilation needs a Roslyn-based provider on .NET 10. -->
    <!-- Roslyn: runtime C# compilation of party-mode sources (CodeDom compilation is unsupported on .NET 10). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- macOS publishes need the SkiaSharp dylib from the macOS native-asset package; only pulled in
         when building on/for macOS so the Linux/Windows builds are unaffected. -->
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <!-- GstSharp removed: ships net45 assemblies only, unusable on .NET 10 (see S3).
         TODO(linux-port): the native PortAudio library (libportaudio) is required at runtime. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VocaluxeLib\VocaluxeLib.csproj" />
    <ProjectReference Include="..\Community.CsharpSqlite\Community.CsharpSqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Website\locales\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\js\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
