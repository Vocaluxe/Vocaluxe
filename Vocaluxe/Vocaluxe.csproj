  <Target Name="PostBuildMacros">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="Targets" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <VersionNumber Include="@(Targets->'%(Version)')" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <PostBuildEventDependsOn>
      $(PostBuildEventDependsOn);
      PostBuildMacros;
    </PostBuildEventDependsOn>
  </PropertyGroup>
  <Target Name="copyWebAppAfterBuild" BeforeTargets="AfterBuild" Condition="'$(Configuration)' != 'ReleaseLinux' AND '$(Configuration)' != 'DebugLinux'">
    <Message Text="copy the WebApp (built by VocaluxeWeb) to the Website folder" Importance="normal" />
    <ItemGroup>
      <WebAppFiles Include="$(ProjectDir)..\WebApp\dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)Website" />
    <Copy SourceFiles="@(WebAppFiles)" DestinationFiles="@(WebAppFiles->'$(TargetDir)Website\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="managedDepCopyAfterBuild" BeforeTargets="AfterBuild">
    <Message Text="move all libs to the managed dependencies folder" Importance="normal" />
    <ItemGroup>
      <RootDLLFilesToMove Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <ItemGroup>
      <RootDLLCompanionFiles Include="@(RootDLLFilesToMove->'%(RootDir)%(Directory)%(Filename).pdb');@(RootDLLFilesToMove->'%(RootDir)%(Directory)%(Filename).xml');@(RootDLLFilesToMove->'%(FullPath).config')" />
      <OtherFilesToMove Include="@(RootDLLCompanionFiles)" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
    <ItemGroup>
      <x64FolderFilesToMove Include="$(TargetDir)x64\*.*" />
    </ItemGroup>
    <ItemGroup>
      <x86FolderFilesToMove Include="$(TargetDir)x86\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RootDLLFilesToMove)" DestinationFiles="@(RootDLLFilesToMove->'$(TargetDir)libs\managed\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(x64FolderFilesToMove)" DestinationFiles="@(x64FolderFilesToMove->'$(TargetDir)libs\managed\x64\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(x86FolderFilesToMove)" DestinationFiles="@(x86FolderFilesToMove->'$(TargetDir)libs\managed\x86\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(OtherFilesToMove)" DestinationFiles="@(OtherFilesToMove->'$(TargetDir)libs\managed\%(Filename)%(Extension)')" />
    <Delete Files="@(RootDLLFilesToMove)" />
    <Delete Files="@(x64FolderFilesToMove)" />
    <Delete Files="@(x86FolderFilesToMove)" />
    <Delete Files="@(OtherFilesToMove)" />
    <RemoveDir Directories="$(TargetDir)\x64\;$(TargetDir)\x86\" />
  </Target>
