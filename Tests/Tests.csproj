<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tests</RootNamespace>
    <AssemblyName>Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Keep the hand-written Properties/AssemblyInfo.cs instead of the SDK-generated attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The .tt template's generated output (CLogTest.cs) is checked in; don't run T4 here. -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VocaluxeLib\VocaluxeLib.csproj" />
    <ProjectReference Include="..\Vocaluxe\Vocaluxe.csproj" />
    <ProjectReference Include="..\PartyModes\PartyModeChallenge\PartyModeChallenge.csproj" />
  </ItemGroup>

  <!-- Test data: copied next to the test assembly preserving the VocaluxeLib/XML/TestFiles layout. -->
  <ItemGroup>
    <None Include="VocaluxeLib/XML/TestFiles/**/*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
