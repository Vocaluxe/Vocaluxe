<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>VocaluxeLib.PartyModes.Challenge</RootNamespace>
    <AssemblyName>Challenge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0612;CA1416</NoWarn>
    <!-- TODO(linux-port): re-add runtime source copy to Output/PartyModes/.../Code in M4 packaging. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VocaluxeLib\VocaluxeLib.csproj" />
  </ItemGroup>

</Project>
